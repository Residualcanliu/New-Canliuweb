PORT=8787
HOST=127.0.0.1
DB_PATH=data/site.db
ADMIN_USER=gch
# 至少 12 位，部署时换成随机密码
ADMIN_PASS=change-me-to-a-long-random-password
# 逗号分隔的后台 IP 白名单；为空表示不限制（仅本地开发）
ADMIN_IPS=
# 用于 cookie 签名与 IP 哈希，部署时换成随机值
HASH_SALT=change-me-random-string
SESSION_TTL_HOURS=12
# 域名 + HTTPS 就绪后改成 1
COOKIE_SECURE=0
NODE_ENV=development
