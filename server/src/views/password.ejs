<%- include('partials/head', { title: '修改密码', session }) %>
<h1>修改密码</h1>
<% if (done) { %><p style="color:#1f6b43"><b><%= error %></b></p><% } %>
<% if (!done && error) { %><p class="err"><%= error %></p><% } %>
<form class="stack" method="post" action="/admin/password" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>当前密码<input type="password" name="current" required maxlength="72" autocomplete="current-password"></label>
  <label>新密码（至少 10 位）<input type="password" name="next" required minlength="10" maxlength="72" autocomplete="new-password"></label>
  <label>再输一次<input type="password" name="confirm" required minlength="10" maxlength="72" autocomplete="new-password"></label>
  <button class="btn" type="submit">更新密码</button>
</form>
<p class="muted">改完只保留当前这台设备的登录，其它会话立即失效。密码用 argon2id 存，明文不落库。</p>
<%- include('partials/foot') %>
